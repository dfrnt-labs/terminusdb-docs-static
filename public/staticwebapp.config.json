    },
    {
      "route": "/docs/dfrnt-dashboard-reference",
      "redirect": "/docs/terminusdb-cms-dashboard-reference/",
      "statusCode": 301
    },
    {
      "route": "/docs/dfrnt-data-types",
      "redirect": "/docs/terminusdb-data-types/",
      "statusCode": 301
    },
    {
      "route": "/docs/topics/dfrnt-cloud",
      "redirect": "/docs/topics/terminusdb-cloud/",
      "statusCode": 301
    },
    {
      "route": "/docs/knowledge-graph-version-control",
      "redirect": "/docs/knowledge-graph-database-version-control/",
