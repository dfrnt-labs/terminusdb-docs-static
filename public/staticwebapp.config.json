      "redirect": "/docs/cloud/",
      "statusCode": 301
    },
    {
      "route": "/docs/what-is-dfrnt",
      "redirect": "/docs/cloud/",
      "statusCode": 301
    },
    {
      "route": "/docs/how-to-connect-dfrnt-hub",
      "redirect": "/docs/how-to-connect-terminusdb-cloud/",
